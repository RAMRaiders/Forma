{
  "name": "@ramraiders/forma-sdk",
  "version": "1.39.0",
  "description": "The public API Forma themes and custom interfaces use to control the frontend.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "default": "./dist/mock/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/RAMRaiders/Forma.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
