{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RomDex",
  "version": "0.0.0",
  "identifier": "com.ramraiders.romdex",
  "build": {
    "beforeDevCommand": "npm run build --workspace @romdex/theme-default -- --watch",
    "beforeBuildCommand": "npm run build --workspace @romdex/theme-default",
    "frontendDist": "boot"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
