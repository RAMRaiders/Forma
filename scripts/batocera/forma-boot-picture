#!/bin/bash
# Puts Forma's boot picture where Batocera shows its own logo first thing at boot, so the box
# shows Forma from the start:
#
#   forma-boot-picture <picture.png>     put it in place (Forma runs this when it redraws it)
#   forma-boot-picture --remove          give Batocera its logo back (uninstall.sh runs this)
#
# Batocera draws /usr/share/batocera/splash/boot-logo.png (boot-logo-4x3.png on a 4:3 screen)
# before /userdata is even mounted, from its read-only system. Its supported way to change that
# system is a saved overlay, /boot/boot/overlay (an ext4 image laid over it at every boot, as
# `batocera-save-overlay` writes it). This adds just the two pictures to that overlay, making
# one if there is none, and changes nothing else in it. A Batocera update drops the overlay;
# Forma puts the picture back at its next start.
set -eu

OVERLAY=/boot/boot/overlay
SPLASH=usr/share/batocera/splash
# Marks an overlay Forma made, holding nothing but its pictures: --remove deletes it whole.
MARK=.forma-boot-picture
SIZE_MB=16

picture="${1:?usage: forma-boot-picture <picture.png> | --remove}"
if [ "$picture" != "--remove" ] && [ ! -s "$picture" ]; then
    echo "no picture at $picture" >&2
    exit 1
fi

mnt="$(mktemp -d)"
done_with_boot() {
    # (Batocera has no `mountpoint`.)
    if grep -qs " $mnt " /proc/mounts; then umount "$mnt"; fi
    rmdir "$mnt"
    mount -o remount,ro /boot
    sync
}
mount -o remount,rw /boot
trap done_with_boot EXIT

if [ "$picture" = "--remove" ]; then
    [ -e "$OVERLAY" ] || exit 0
    mount -o rw "$OVERLAY" "$mnt"
    rm -f "$mnt/$SPLASH/boot-logo.png" "$mnt/$SPLASH/boot-logo-4x3.png"
    # Forma's own overlay, and nothing else saved in it since: it goes whole.
    others="$(find "$mnt" -mindepth 1 -type f ! -name "$MARK" ! -path "$mnt/lost+found/*" | head -1)"
    if [ -e "$mnt/$MARK" ] && [ -z "$others" ]; then
        umount "$mnt"
        rm -f "$OVERLAY"
    fi
    exit 0
fi

if [ ! -e "$OVERLAY" ]; then
    dd if=/dev/zero of="$OVERLAY" bs=1M count="$SIZE_MB" status=none
    mkfs.ext4 -q "$OVERLAY"
    mount -o rw "$OVERLAY" "$mnt"
    touch "$mnt/$MARK"
else
    mount -o rw "$OVERLAY" "$mnt"
fi
mkdir -p "$mnt/$SPLASH"
cp "$picture" "$mnt/$SPLASH/boot-logo.png.part"
mv "$mnt/$SPLASH/boot-logo.png.part" "$mnt/$SPLASH/boot-logo.png"
cp "$mnt/$SPLASH/boot-logo.png" "$mnt/$SPLASH/boot-logo-4x3.png"
