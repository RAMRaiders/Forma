#!/bin/bash
# Batocera user service for Forma. Installed as /userdata/system/services/forma by install.sh,
# which enables it and turns Batocera's own start of the screen session off
# (system.es.atstartup=0): at boot this starts the session, with Forma in it in place of
# EmulationStation. uninstall.sh gives the box back to EmulationStation; disabling the service
# alone would leave no session at boot.

# The app, by executable: this script is itself a process named "forma" while it runs, so
# `pgrep -x forma` alone would find it. Any Forma binary under /userdata/system/forma counts,
# including one install.sh has since moved to app.old and deleted ("… (deleted)"): matching
# only the current one left a Forma running from before an update, holding the library open.
DIR=/userdata/system/forma/
STANDALONE="${DIR}bin/forma-standalone"
AUTOSTART=/userdata/system/.config/labwc/autostart
app_pids() {
    for pid in $(pgrep -x forma); do
        case "$(readlink "/proc/$pid/exe")" in
            "$DIR"*/usr/bin/forma | "$DIR"*"/usr/bin/forma (deleted)") echo "$pid" ;;
        esac
    done
}

case "$1" in
    start)
        if pgrep -x labwc > /dev/null; then
            # The session is up (Forma started by hand): Forma joins it.
            nohup "$STANDALONE" > /dev/null 2>&1 &
        else
            # Boot. Batocera writes labwc's autostart afresh at every boot (S14labwc), to start
            # EmulationStation: it starts Forma instead, then the session starts as Batocera's
            # S31emulationstation would.
            if grep -q '^/usr/bin/emulationstation-standalone' "$AUTOSTART"; then
                sed -i "s#^/usr/bin/emulationstation-standalone.*#$STANDALONE > /dev/null 2>\&1#" "$AUTOSTART"
            elif ! grep -qF "$STANDALONE" "$AUTOSTART"; then
                echo "$STANDALONE > /dev/null 2>&1" >> "$AUTOSTART"
            fi
            . /etc/profile.d/xdg.sh
            . /etc/profile.d/dbus.sh
            nohup labwc-launch > /dev/null 2>&1 &
        fi
        ;;
    stop)
        # Anchored, so it does not match a shell whose command line merely mentions the script.
        pkill -f '^/bin/bash /userdata/system/forma/bin/forma-standalone'
        for pid in $(app_pids); do
            # Its WebKit processes (and players) first, at once: left to exit on their own once
            # Forma had gone, WebKit's drawing thread (SkiaGPUWorker) crashed in its exit code at
            # nearly every stop ("free(): corrupted unsorted chunks" in the log). They keep
            # nothing worth saving.
            pkill -9 -P "$pid"
            kill "$pid"
        done
        # Its music and video players, which would otherwise play on: a video left running kept
        # decoding in the background for hours.
        pkill -f '(^|/)mpv .*forma/run/(mpv|video)\.sock'
        # Stopped, whether or not a player was left to stop: pkill finding none (they usually
        # went with Forma's children) is not a failure, and update.sh stops on one.
        true
        ;;
    status)
        if [ -n "$(app_pids)" ]; then echo "Forma is running"; else echo "Forma is not running"; fi
        ;;
esac
