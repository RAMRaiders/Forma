#!/bin/bash
# Runs Forma in Batocera's labwc session in place of EmulationStation.
#
# Forma's service starts the session itself (Batocera's own start of it is off, see install.sh),
# with labwc's autostart running this, so EmulationStation is never part of a boot. It starts
# only when Forma quits to it (its "Switch to EmulationStation"), and as the last resort: when
# Forma cannot start, or fails three times in two minutes, counting "never became ready" as a
# failure.

APP=/userdata/system/forma/app/AppRun
LOG=/userdata/system/logs/forma.log
READY=/var/run/forma.ready
# Written by Forma once its cover has gone over the theme: the boot picture can go then.
UP="$READY.up"
# Generous: at boot a Pi reads Forma's ~400 MB of libraries off its card while everything else
# starts too, and a second start only begins that again.
READY_TIMEOUT=60
MAX_FAILURES=3
FAILURE_WINDOW=120
# Matched on the command line: the kernel cuts process names to 15 characters
# ("emulationstatio"), so `pgrep -x emulationstation` never matches.
ES='^emulationstation( |$)'

export WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/var/run HOME=/userdata/system
export FORMA_READY_FILE="$READY" FORMA_FULLSCREEN=1
# AppRun's hooks build their paths from APPDIR, which only the AppImage runtime sets; run from the
# extracted folder it was empty, so GStreamer's plugin path became Batocera's own /usr/lib one:
# hundreds of plugins that do not load against Forma's libraries (15 s at start-up), and video
# that would not play. And a registry of Forma's own, never mixed with Batocera's.
export APPDIR="$(dirname "$APP")"
export GST_REGISTRY_1_0=/userdata/system/forma/cache/gstreamer-registry.bin

log() { echo "$(date '+%F %T') forma-standalone: $*" >> "$LOG"; }

# wait_for <seconds> <command...>: true as soon as the command succeeds.
wait_for() {
    local ticks=$(( $1 * 10 )); shift
    while [ "$ticks" -gt 0 ]; do
        "$@" > /dev/null 2>&1 && return 0
        sleep 0.1
        ticks=$(( ticks - 1 ))
    done
    return 1
}

back_to_emulationstation() {
    log "handing the screen back to EmulationStation: $1"
    drop_backdrop
    stop_music
    # As labwc's autostart starts it.
    # Two lines: backgrounding `cd && nohup …` would leave a copy of this script as its parent.
    cd /userdata
    nohup /usr/bin/emulationstation-standalone > /dev/null 2>&1 &
    exit 0
}

# Forma's music and video players (mpv, named by their sockets): they must not play on over
# EmulationStation.
stop_music() {
    pkill -f '(^|/)mpv .*forma/run/(mpv|video)\.sock' || true
}

# Games' videos play in an mpv window (app id `forma-video`) under Forma's see-through window:
# a labwc rule keeps it at the bottom and away from focus. Batocera may write labwc's config
# afresh, so the rule goes back in at every start, and labwc reads it again.
LABWC_RC=/userdata/system/.config/labwc/rc.xml
VIDEO_RULE='<windowRule identifier="forma-video" ignoreFocusRequest="yes" skipTaskbar="yes" skipWindowSwitcher="yes"><action name="ToggleAlwaysOnBottom" /></windowRule>'
keep_video_under() {
    [ -f "$LABWC_RC" ] || return 0
    grep -q 'identifier="forma-video"' "$LABWC_RC" && return 0
    if grep -q '</windowRules>' "$LABWC_RC"; then
        sed -i "s|</windowRules>|  $VIDEO_RULE\n  </windowRules>|" "$LABWC_RC"
    else
        sed -i "s|</labwc_config>|  <windowRules>$VIDEO_RULE</windowRules>\n</labwc_config>|" "$LABWC_RC"
    fi
    pkill -HUP -x labwc || true
    log "labwc: games' videos kept under Forma"
}

# Forma's library (favourites, history, users, settings) and its caches go with the share disk:
# when the disk holds a library, every Batocera box it is plugged into uses that one; without the
# disk, the box's own copy, in local/. Forma opens them at forma/, where links point at one or
# the other, chosen again at every start. A library put on the disk (copy local/library.db to
# /userdata/saves/forma/) starts the sharing.
FORMA_DIR=/userdata/system/forma
SHARED=/userdata/saves/forma
SHARED_FILES="library.db romdex.sqlite cache/launchbox.db"
choose_library() {
    local where=local f
    # The disk, not the card's own saves/ that Batocera falls back on without it.
    if grep -q ' /userdata/saves ' /proc/mounts && [ -f "$SHARED/library.db" ]; then
        where=shared
    fi
    mkdir -p "$FORMA_DIR/local/cache" "$FORMA_DIR/cache"
    for f in $SHARED_FILES; do
        # A box from before this: its own files become its local copy.
        if [ -f "$FORMA_DIR/$f" ] && [ ! -L "$FORMA_DIR/$f" ]; then
            [ -e "$FORMA_DIR/local/$f" ] || mv "$FORMA_DIR/$f" "$FORMA_DIR/local/$f"
            rm -f "$FORMA_DIR/$f-wal" "$FORMA_DIR/$f-shm"
        fi
        if [ "$where" = shared ] && [ -f "$SHARED/$f" ]; then
            ln -sfn "$SHARED/$f" "$FORMA_DIR/$f"
        else
            ln -sfn "$FORMA_DIR/local/$f" "$FORMA_DIR/$f"
        fi
    done
    log "library: $where ($(readlink "$FORMA_DIR/library.db"))"
}

backdrop=
drop_backdrop() {
    [ -n "$backdrop" ] && kill "$backdrop" 2> /dev/null
    backdrop=
}

mkdir -p "$(dirname "$LOG")"
choose_library
# A Forma that cannot start hands the screen to EmulationStation rather than leaving it black.
[ -x "$APP" ] || back_to_emulationstation "no Forma at $APP"
wait_for 60 wlr-randr || back_to_emulationstation "no Wayland compositor"
keep_video_under
# Forma's boot picture (what Batocera showed while booting) under everything, from the moment
# the compositor is up until Forma is ready: no black screen while Forma loads, and Forma's
# window starts see-through over it.
PICTURE=/userdata/splash/forma.png
if [ -s "$PICTURE" ] && command -v swaybg > /dev/null; then
    swaybg -i "$PICTURE" -m fill > /dev/null 2>&1 &
    backdrop=$!
fi
# An EmulationStation already on screen (Forma started by hand, or just installed over a session
# Batocera started): stop its restart loop, then it.
emulationstation-standalone --stop-rebooting
pkill -f "$ES"
wait_for 20 sh -c "! pgrep -f '$ES'" || pkill -9 -f "$ES"

language="$(batocera-settings-get system.language)"
export LANG="${language:-en_US}.UTF-8" LC_ALL="${language:-en_US}.UTF-8"

failures=()
while true; do
    rm -f "$READY" "$UP"
    log "starting Forma"
    cd /userdata
    "$APP" >> "$LOG" 2>&1 &
    pid=$!

    # Ready, or gone, or out of time.
    ticks=$(( READY_TIMEOUT * 10 ))
    while [ "$ticks" -gt 0 ] && [ ! -e "$READY" ] && kill -0 "$pid" 2> /dev/null; do
        sleep 0.1
        ticks=$(( ticks - 1 ))
    done
    # Ready: the picture goes once Forma's cover has gone over the theme (on a slow or hot Pi
    # that can take seconds after ready; the cover hides its logo, the picture's, until then),
    # and its fade is done. At most 10 s.
    if [ -e "$READY" ] && [ -n "$backdrop" ]; then
        (
            for _ in $(seq 100); do [ -e "$UP" ] && break; sleep 0.1; done
            sleep 0.5
            kill "$backdrop" 2> /dev/null
        ) &
    fi
    if [ ! -e "$READY" ] && kill -0 "$pid" 2> /dev/null; then
        log "Forma did not become ready within ${READY_TIMEOUT}s"
        pkill -x forma
    fi

    wait "$pid"
    code=$?
    if [ -e "$READY" ] && [ "$code" -eq 0 ]; then
        back_to_emulationstation "Forma quit"
    fi

    log "Forma failed (exit $code)"
    now=$(date +%s)
    recent=()
    for t in "${failures[@]}" "$now"; do
        [ $(( now - t )) -le "$FAILURE_WINDOW" ] && recent+=("$t")
    done
    failures=("${recent[@]}")
    if [ "${#failures[@]}" -ge "$MAX_FAILURES" ]; then
        back_to_emulationstation "Forma failed ${MAX_FAILURES} times in ${FAILURE_WINDOW}s"
    fi
    sleep 2
done
